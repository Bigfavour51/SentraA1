#include <Arduino.h>
#include "speedDriver.h"
#include "theftTrigger.h"
#include "uartDriver.h"

#define IR_A PA0
#define IR_B PA1
#define RELAY_PIN PB0
#define ALARM_PIN PA6


void setup()
{
    Serial.begin(9600);
    uart_init(UART_BAUDRATE);
    Wire.begin();
    speedDriver_begin(IR_A, IR_B);
    TheftTrigger_Init(RELAY_PIN, ALARM_PIN);

}

void loop()
{
    detectTouch();
    if (isTouched) {TheftTrigger_Update();}

    if (speedDriver_speedAvailable())
    {
        speedDriver_getSpeedKmh();
        if (speedValue > overspeedTH)
        { uart_send_byte(speedValue, isTouched); }
        speedDriver_reset();
    }
}



